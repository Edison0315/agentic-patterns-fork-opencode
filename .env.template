

# AI KEYS necesarias para el proyecto
## Recuerda que sólo necesitas la que usarás en el proyecto


# https://console.groq.com/keys
# GROQ_API_KEY=gsk_XXXXXXX


# https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=sk-proj-

# https://platform.claude.com/settings/workspaces/default/keys
# ANTHROPIC_API_KEY=sk-ant-

# https://aistudio.google.com/api-keys
# GOOGLE_GENERATIVE_AI_API_KEY=AQ.XXXXXX

# ==========================================================
# OPENCODE (proveedor externo)
# ==========================================================
# Docs: https://opencode.ai/v2/docs/console/models/
#
# Console (pay-as-you-go) y Go:
# Crear la key en https://opencode.ai/console > Account > Personal API keys
# Formato: oc_sk_...
OPENCODE_API_KEY=

# Conexiones propias (AWS Bedrock sincronizado en tu cuenta):
# El token de sesión lo puedes copiar de:
#   opencode db "SELECT access_token FROM account"
# El org id de:
#   opencode db "SELECT active_org_id FROM account_state"
# Y la URL de la conexión en https://opencode.ai/console > Providers
OPENCODE_CONSOLE_TOKEN=
OPENCODE_ORG_ID=
OPENCODE_EXTERNAL_PROV_URL=
